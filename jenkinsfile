pipeline{
    agent any
    tools{
        maven 'maven'
        jdk 'jdk-17'
    }
    stages{
        stage('Git-checkout'){
            steps{
                git branch: 'main',
                url: 'https://github.com/VamsiJaddu/DevSecOps-project.git'
            }
        }
        stage('Compile'){
            steps{
                sh '''
                    echo "Compiling the code.."
                    mvn compile
                '''
            }
        }
        stage('Build'){ 
            steps{
                sh '''
                    echo "Building the code.."
                    mvn package
                '''
            }

        }
        stage('Docker-build'){
            steps{
                sh '''
                    printenv
                    echo "Building Docker image.."
                    docker build -t gameapp:latest .
                '''
            }
        }
    }
}