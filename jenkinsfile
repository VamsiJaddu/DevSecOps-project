pipeline{
    agent any
    tools{
        maven 'mav'
    }
    stages{
        stage('Git-checkout'){
            steps{
                git branch: 'main',
                url: 'https://github.com/VamsiJaddu/DevSecOps-project.git'
            }
        }
        stage('Compile'){
            steps{
                sh '''
                    echo "Compiling the code.."
                    mvn compile
                '''
            }
        }
        stage('Build'){ 
            steps{
                sh '''
                    echo "Building the code.."
                    mvn package
                '''
            }

        }
    }
}